# 107 算力平台答疑智能体 — 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# ── 应用 ──
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ── 数据库 ──
DATABASE_URL=sqlite+aiosqlite:///data/app.db

# ── Redis（生产环境） ──
REDIS_URL=redis://localhost:6379/0
SESSION_TTL=3600

# ── LLM API ──
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=qwen2.5-7b
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_CACHE_TTL=1800

# ── SSH 连接（平台日志查询） ──
SSH_HOST=107.ustc.edu.cn
SSH_PORT=22
SSH_USER=your-username
SSH_KEY_PATH=~/.ssh/id_rsa
SSH_TIMEOUT=30
SSH_MAX_RETRIES=3

# ── 向量数据库 ──
CHROMA_PERSIST_DIR=data/chroma
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
CHUNK_SIZE=256
CHUNK_OVERLAP=32

# ── 意图识别 ──
INTENT_THRESHOLD=0.6

# ── 推送通道 ──
WECHAT_BOT_WEBHOOK=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# ── 安全 ──
API_RATE_LIMIT=100
CORS_ORIGINS=*
